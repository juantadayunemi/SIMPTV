"""
🌩️ Custom Storage Backends for AWS S3
Permite usar S3 para archivos multimedia manteniendo JSON local

Uso:
- Videos, thumbnails, ROI YOLO, Placas → S3
- JSON (datos/) → Local (acceso rápido)
"""

from django.conf import settings
from storages.backends.s3boto3 import S3Boto3Storage


class MediaStorage(S3Boto3Storage):
    """
    Almacenamiento S3 para archivos multimedia
    
    Guarda en S3:
    - Videos procesados
    - Thumbnails generados
    - ROI YOLO (imágenes de vehículos detectados)
    - Placas (imágenes de placas detectadas)
    
    NO guarda en S3:
    - Archivos JSON de la carpeta 'datos/' (se mantienen locales)
    """
    bucket_name = settings.AWS_STORAGE_BUCKET_NAME
    location = 'media'
    file_overwrite = False
    default_acl = None
    querystring_auth = True  # URLs firmadas (privadas y seguras)
    querystring_expire = 3600  # URLs expiran en 1 hora
    
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)


class VideoStorage(S3Boto3Storage):
    """
    ✅ ALMACENAMIENTO HÍBRIDO - Solo Videos en S3
    
    Guarda ÚNICAMENTE en S3:
    - Videos (.mp4, .avi, etc.) - Son grandes (50-500 MB)
    
    SIGUE siendo LOCAL (media/):
    - ROI YOLO (imágenes de vehículos) ← Acceso RÁPIDO
    - Placas (imágenes de placas) ← Acceso RÁPIDO
    - Thumbnails (miniaturas) ← Acceso RÁPIDO
    - JSON (datos/) ← Acceso RÁPIDO
    
    Beneficios:
    - Ahorra 90% del espacio en disco (videos son lo más pesado)
    - Procesamiento rápido (ROI/Placas/JSON locales)
    - Menor costo S3 ($1.50-2/mes vs $5-7/mes)
    """
    bucket_name = settings.AWS_STORAGE_BUCKET_NAME
    location = 'media/videos'  # Solo carpeta videos/
    file_overwrite = False
    default_acl = None
    custom_domain = settings.AWS_S3_CUSTOM_DOMAIN
    querystring_auth = True
    querystring_expire = 7200  # Videos: 2 horas (más tiempo que otros)
